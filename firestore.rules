rules_version = '2';

/**
 * Quy tắc bảo mật Firestore — đây là "người gác cổng" thật sự của dữ liệu.
 * Mã JavaScript trên web có thể bị sửa tuỳ ý trong trình duyệt, nên mọi quyền hạn
 * đều được kiểm tra lại ở đây.
 *
 *   GVCN        : toàn quyền
 *   LOP_TRUONG  : xem cả lớp, tạo/sửa trang tuần, ghi nhật ký, chọn xếp loại tháng
 *   TO_TRUONG   : xem cả lớp, chỉ ghi nhật ký cho học sinh thuộc tổ mình
 *   PHU_HUYNH   : chỉ xem dữ liệu của đúng con mình
 *   chưa đăng nhập: chỉ đọc được tên lớp (cauHinh) và ánh xạ tên đăng nhập → email
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Hàm dùng chung ----------
    function signedIn() { return request.auth != null; }
    function hoSoPath() { return /databases/$(database)/documents/taiKhoan/$(request.auth.uid); }
    function me() { return get(hoSoPath()).data; }
    function active() { return signedIn() && exists(hoSoPath()) && me().trangThai == 'HOAT_DONG'; }
    function role() { return me().vaiTro; }
    function isGV() { return active() && role() == 'GVCN'; }
    function isLeader() { return active() && role() in ['GVCN', 'LOP_TRUONG']; }
    function isStaff() { return active() && role() in ['GVCN', 'LOP_TRUONG', 'TO_TRUONG']; }
    function isParentOf(maHS) { return active() && role() == 'PHU_HUYNH' && me().maHS == maHS; }

    // Chưa khởi tạo = chưa có heThong/khoiTao. Chỉ dùng cho lần cài đặt đầu tiên.
    function chuaKhoiTao() {
      return signedIn() && !exists(/databases/$(database)/documents/heThong/khoiTao);
    }

    function hocSinhDoc(maHS) { return get(/databases/$(database)/documents/hocSinh/$(maHS)).data; }
    function trongTo(maHS) { return role() != 'TO_TRUONG' || hocSinhDoc(maHS).to == me().toPhuTrach; }

    function thangPath(maHS, thang) {
      return /databases/$(database)/documents/xepLoaiThang/$(maHS + '_' + string(thang));
    }
    function thangDaChot(maHS, thang) {
      return exists(thangPath(maHS, thang)) && get(thangPath(maHS, thang)).data.daChot == true;
    }

    // ---------- Khởi tạo & cấu hình ----------
    match /heThong/{id} {
      allow read: if true;
      allow create: if chuaKhoiTao() && id == 'khoiTao';
    }

    match /cauHinh/{id} {
      allow read: if true;                       // trang đăng nhập cần tên lớp
      allow create: if chuaKhoiTao() || isGV();
      allow update, delete: if isGV();
    }

    match /danhMucLoi/{id} {
      allow read: if active();
      allow create: if chuaKhoiTao() || isGV();
      allow update, delete: if isGV();
    }
    match /danhMucCong/{id} {
      allow read: if active();
      allow create: if chuaKhoiTao() || isGV();
      allow update, delete: if isGV();
    }

    // ---------- Tài khoản ----------
    // Chỉ cho đọc từng tên đăng nhập một (không liệt kê được cả danh sách).
    match /dangNhap/{ten} {
      allow get: if true;
      allow list: if false;
      allow create: if chuaKhoiTao() || isGV();
      allow update, delete: if isGV();
    }

    match /taiKhoan/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isGV());
      allow list: if isGV();
      allow create: if isGV()
        || (chuaKhoiTao() && request.auth.uid == uid && request.resource.data.vaiTro == 'GVCN');
      // Người dùng chỉ được tự tắt cờ "lần đầu" sau khi đổi mật khẩu
      allow update: if isGV()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lanDau'])
            && request.resource.data.lanDau == false);
      allow delete: if isGV();
    }

    // ---------- Lớp & lịch tuần ----------
    match /hocSinh/{maHS} {
      allow read: if isStaff() || isParentOf(maHS);
      allow write: if isGV();
    }

    match /tuan/{maTuan} {
      allow read: if active();
      allow write: if isLeader();
    }

    // ---------- Nhật ký (xoá mềm, không xoá cứng) ----------
    match /nhatKy/{id} {
      allow read: if isStaff() || isParentOf(resource.data.maHS);

      allow create: if isStaff()
        && request.resource.data.trangThai == 'HOAT_DONG'
        && request.resource.data.loai in ['LOI', 'CONG']
        && request.resource.data.diem is number
        && request.resource.data.nguoiNhap == me().tenDangNhap
        && request.resource.data.thoiGian == request.time
        && trongTo(request.resource.data.maHS)
        && !thangDaChot(request.resource.data.maHS, request.resource.data.thang);

      allow update: if isStaff() && (
        // Xoá mềm: tổ trưởng chỉ trong tổ mình, trong N ngày; tháng chưa chốt
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trangThai'])
          && resource.data.trangThai == 'HOAT_DONG'
          && request.resource.data.trangThai == 'DA_XOA'
          && trongTo(resource.data.maHS)
          && !thangDaChot(resource.data.maHS, resource.data.thang)
          && (role() == 'GVCN'
              || request.time < resource.data.thoiGian
                  + duration.value(get(/databases/$(database)/documents/cauHinh/main).data.SoNgayDuocSua, 'd')))
        // Sửa trang tuần làm đổi tháng của các mục đã ghi
        || (isLeader()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['thang', 'hocKy'])
            && !thangDaChot(resource.data.maHS, resource.data.thang))
      );

      allow delete: if isGV();      // chỉ dùng khi bắt đầu năm học mới
    }

    // ---------- Số liệu & xếp loại tháng ----------
    // Tổ trưởng chỉ được cập nhật các cột máy tính; xếp loại do lớp trưởng / GVCN chọn.
    match /xepLoaiThang/{id} {
      allow read: if isStaff() || isParentOf(resource.data.maHS);

      allow create: if isGV()
        || (isStaff()
            && request.resource.data.daChot == false
            && (role() != 'TO_TRUONG' || request.resource.data.xepLoai == ''));

      allow update: if isGV()
        || (isStaff()
            && resource.data.daChot == false
            && request.resource.data.daChot == false
            && (role() != 'TO_TRUONG'
                || !request.resource.data.diff(resource.data).affectedKeys()
                    .hasAny(['xepLoai', 'nguoiNhap', 'ghiChu'])));

      allow delete: if isGV();
    }

    // ---------- Nhật ký hệ thống: ai làm gì, khi nào ----------
    match /nhatKyHeThong/{id} {
      allow read, delete: if isGV();
      allow create: if active()
        && request.resource.data.nguoiDung == me().tenDangNhap
        && request.resource.data.thoiGian == request.time;
    }
  }
}
